<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Dropshipping Store</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <div class="logo">MyDropshippingStore</div>
        <nav>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="products.html">Products</a></li>
                <li><a href="about.html">About</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
        </nav>
    </header>
    
    <section class="intro">
        <h1>Welcome to My Dropshipping Store</h1>
        <p>Find amazing products at unbeatable prices!</p>
        <a href="products.html" class="btn">Shop Now</a>
    </section>
    
    <section class="featured-products">
        <h2>Featured Products</h2>
        <div class="product-grid">
            <div class="product">
                <img src="https://via.placeholder.com/200" alt="Product 1">
                <h3>Product 1</h3>
                <p>$25.99</p>
                <a href="product1.html" class="btn">View Details</a>
            </div>
            <div class="product">
                <img src="https://via.placeholder.com/200" alt="Product 2">
                <h3>Product 2</h3>
                <p>$15.99</p>
                <a href="product2.html" class="btn">View Details</a>
            </div>
            <!-- Add more products here -->
        </div>
    </section>
    
    <footer>
        <p>&copy; 2025 My Dropshipping Store | All Rights Reserved</p>
    </footer>
</body>
</html>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    color: #333;
}

header {
    background-color: #333;
    color: #fff;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header .logo {
    font-size: 1.5rem;
    font-weight: bold;
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li {
    margin-right: 20px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

.intro {
    text-align: center;
    padding: 50px;
    background-color: #fff;
}

.intro h1 {
    font-size: 2.5rem;
    margin-bottom: 20px;
}

.intro .btn {
    background-color: #f09;
    padding: 10px 20px;
    color: white;
    text-decoration: none;
    border-radius: 5px;
}

.featured-products {
    padding: 50px 20px;
}

.featured-products h2 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 2rem;
}

.product-grid {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
}

.product {
    background-color: white;
    border-radius: 10px;
    padding: 20px;
    margin: 10px;
    width: 200px;
    text-align: center;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.product img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
}

.product h3 {
    font-size: 1.2rem;
    margin-top: 10px;
}

.product .btn {
    background-color: #f09;
    padding: 8px 15px;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    margin-top: 10px;
}

footer {
    background-color: #333;
    color: white;
    padding: 20px;
    text-align: center;
}
